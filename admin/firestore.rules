rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The payout schedule: anyone (the app) may read it; only admins write.
    match /config/payout_schedule {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['programs', 'updatedAt', 'updatedBy'])
        && request.resource.data.programs is list
        && request.resource.data.programs.size() > 0
        && request.resource.data.programs.size() <= 50
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string;
      allow delete: if false;
    }

    // Admin allow-list. Create documents here by hand in the console
    // (document ID = the user's UID). Clients can only check their own entry.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Optional cloud copy of the person's budget data: only that person,
    // signed in with Google (not anonymous), can read or write it. One
    // document, a single JSON string, capped below Firestore's 1 MiB limit.
    match /users/{uid}/backup/{doc} {
      allow read, delete: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && doc == 'latest'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAtMs', 'schema'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 900000
        && request.resource.data.updatedAtMs is int
        && request.resource.data.schema == 1;
    }

    // Billing data is written only by the Cloud Function (Admin SDK, which
    // bypasses these rules) and never read by clients: the app gets its
    // entitlement from the function's reply. Closed explicitly so a future
    // wildcard rule cannot open it by accident.
    match /subscriptions/{id} {
      allow read, write: if false;
    }
    match /entitlements/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
